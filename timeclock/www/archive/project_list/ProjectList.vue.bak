<template>
    <H1>{{ header }}</H1>
    <ul>
        <li v-for="project in projects" :key="project.name">
            {{ project.name }} - {{ project.project_name }}
        </li>
    </ul>
</template>
<script setup>
import { onMounted, ref } from 'vue'

const projects = ref([]);
const header = ref('Active Projects')

onMounted(() => {
    projects.value = [
        { name: 'Project 1', project_name: 'Project 1' },
        { name: 'Project 2', project_name: 'Project 2' },
        { name: 'Project 3', project_name: 'Project 3' },
    ]
    frappe.xcall('timeclock.www.project_list.get_active_projects')
    .then(data => {
        projects.value = data.projects;
    })
    .catch(error => {
        console.error("Error fetching projects:", error);
        // Handle the error appropriately, e.g., show a user-friendly message.
    });
})
</script>