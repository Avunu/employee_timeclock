	"type": "module",
	"scripts": {
		"build": "VITE_APP=timeclock vite build && VITE_APP=job_timeclock vite build && node scripts/vite-register.mjs",
		"build:job_timeclock": "VITE_APP=job_timeclock vite build",
		"build:timeclock": "VITE_APP=timeclock vite build",
		"dev:job_timeclock": "VITE_APP=job_timeclock vite build --watch",
		"dev:timeclock": "VITE_APP=timeclock vite build --watch",
		"upgrade": "npx npm-check-updates -u && yarn install && npx yarn-audit-fix && yarn add -D tailwindcss@^3.4",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:css": "stylelint \"employee_timeclock/public/**/*.scss\"",
		"typecheck": "tsc --build tsconfig.solution.json && node scripts/vue-tsc.cjs --noEmit -p tsconfig.json",
		"lint:py": "uv run --frozen --project tools ruff check . && uv run --frozen --project tools ruff format --check .",
		"typecheck:py": "uv run --frozen --project tools ty check --python \"${FRAPPE_BENCH_ROOT:-.frappe-nix/bench}/env\"",
		"check": "yarn -s format:check && yarn -s lint && yarn -s lint:css && yarn -s typecheck"
	},
