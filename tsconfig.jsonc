{
//   "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": false,
    "strictNullChecks": false,
    "jsx": "preserve",
    "isolatedModules": true,
    // "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["timeclock/public/js/*"],
      "@job_timeclock/*": ["timeclock/public/js/job_timeclock/*"],
      "@timeclock/*": ["timeclock/public/js/timeclock/*"]
    }
  },
  "include": [
    "*.ts",
    "timeclock/public/js/**/*.ts",
    "timeclock/public/js/**/*.d.ts",
    "timeclock/public/js/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "timeclock/public/dist"
  ]
}