import { defineConfig } from 'vite';
import vue from '@vitejs/plugin-vue';
import path from 'path';

function getViteConfig(entry, directory) {
  return defineConfig({
    plugins: [vue()],
    build: {
      lib: {
        entry: path.resolve(__dirname, entry),
        name: directory,
        fileName: (format) => `index.js`, // creates module only output
      },
      outDir: `./${directory}/www/${directory}/`,
      root: './',
      target: 'es2020',
      emptyOutDir: false,
      minify: false,
    },
    optimizeDeps: {},
    define: {
      'process.env': process.env,
    },
  });
}

// Export two configurations
export default [
  getViteConfig('timeclock.js', 'timeclock'),
  getViteConfig('project_list.js', 'project_list'),
];
