{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["timeclock/public/js/*"],
      "@job_timeclock/*": ["timeclock/public/js/job_timeclock/*"],
      "@timeclock/*": ["timeclock/public/js/timeclock/*"]
    }
  },
  "include": [
    "timeclock/public/js/**/*.ts",
    "timeclock/public/js/**/*.d.ts",
    "timeclock/public/js/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "timeclock/public/dist"
  ]
}