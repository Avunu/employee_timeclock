{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "import"],
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "warn",
		"pedantic": "off"
	},
	"env": {
		"builtin": true,
		"es2024": true,
		"browser": true
	},
	"rules": {
		"typescript/no-explicit-any": "error",
		"typescript/ban-ts-comment": "error",
		"typescript/consistent-type-imports": "error",
		"no-console": [
			"warn",
			{
				"allow": ["error", "warn"]
			}
		],
		"import/no-cycle": "off",
		"no-underscore-dangle": "off",
		"unicorn/consistent-function-scoping": "off",
		"unicorn/no-array-sort": "off"
	},
	"ignorePatterns": [
		"timeclock/public/dist/**",
		".frappe-nix/**",
		".dev-dist/**",
		"nix/**",
		"docs-site/**",
		"types/doctypes.d.ts",
		"components.d.ts",
		"timeclock/public/js/job_timeclock/components.d.ts",
		"timeclock/public/js/job_timeclock/types.ts",
		"timeclock/www/job_timeclock_legacy/index.css",
		"timeclock/www/job_timeclock_legacy/index.js",
		"timeclock/www/job_timeclock_legacy/**"
	],
	"overrides": [
		{
			"files": ["scripts/**", "marketplace/**", "ci/**", "test/**"],
			"env": {
				"node": true
			},
			"rules": {
				"no-console": "off",
				"no-await-in-loop": "off",
				"import/no-unassigned-import": "off"
			}
		},
		{
			"files": ["timeclock/public/js/*.bundle.ts", "timeclock/public/js/*.bundle.js"],
			"rules": {
				"import/no-unassigned-import": "off"
			}
		},
		{
			"files": [
				"timeclock/public/js/employee.js",
				"timeclock/public/js/job_card.js",
				"timeclock/public/js/job_card_list.js",
				"timeclock/timeclock/doctype/workday/workday.js",
				"timeclock/timeclock/doctype/workday/workday_list.js",
				"timeclock/timeclock/page/workday_management/workday_management.js",
				"timeclock/timeclock/report/workday_management/workday_management.js"
			],
			"globals": {
				"frappe": "readonly",
				"__": "readonly",
				"cur_frm": "readonly",
				"cur_list": "readonly",
				"locals": "readonly",
				"$": "readonly",
				"jQuery": "readonly",
				"moment": "readonly",
				"erpnext": "readonly",
				"hrms": "readonly"
			}
		},
		{
			"files": ["timeclock/timeclock/web_form/employee_timelog/employee_timelog.js"],
			"globals": {
				"frappe": "readonly",
				"__": "readonly",
				"$": "readonly",
				"jQuery": "readonly"
			}
		},
		{
			"files": [
				"timeclock/public/js/job_timeclock/components/Column.vue",
				"timeclock/public/js/job_timeclock/job_timeclock.ts",
				"timeclock/public/js/timeclock/timeclock.ts"
			],
			"rules": {
				"import/no-unassigned-import": "off"
			}
		}
	]
}
