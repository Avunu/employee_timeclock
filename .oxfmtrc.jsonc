// frappe-nix:managed — generated by frappe-nix (`frappe-init --sync`); do not edit. Customise via [tool.frappe-nix.js.oxfmt].
// Tabs and 110 columns (js.format-tabs, js.format-width) are frappe's convention.
// Anything .gitignore'd is skipped without being listed.
{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"printWidth": 110,
	"ignorePatterns": [
		// frappe's exporter writes every JSON under the package and rewrites it on export
		"employee_timeclock/**/*.json",
		"nix/**",
		"docs-site/**",
		"docs/screenshots/**",
		// written by release-please
		"CHANGELOG.md",
		".release-please-manifest.json",
		// generated by frappe-types gen-doctypes
		"types/doctypes.d.ts",
		"components.d.ts",
		"employee_timeclock/public/js/job_timeclock/components.d.ts",
		"employee_timeclock/public/js/job_timeclock/types.ts",
		"employee_timeclock/www/job_timeclock_legacy/index.css",
		"employee_timeclock/www/job_timeclock_legacy/index.js",
		"employee_timeclock/www/job_timeclock_legacy/index.html",
